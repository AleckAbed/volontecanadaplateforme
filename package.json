{
  "name": "isomorphic",
  "version": "7.6.2",
  "description": "A nextjs template to build dashboard",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type:check": "turbo type:check",
    "build": "turbo build",
    "start": "turbo start",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "cache:clean": "turbo cache:clean && rm -rf .turbo",
    "iso:dev": "turbo dev --filter=iso",
    "iso:lint": "turbo lint --filter=iso",
    "iso:build": "turbo build --filter=iso",
    "iso:start": "turbo start --filter=iso",
    "iso:clean": "turbo clean --filter=iso",
    "starter:dev": "turbo dev --filter=starter",
    "starter:lint": "turbo lint --filter=starter",
    "starter:build": "turbo build --filter=starter",
    "starter:start": "turbo start --filter=starter",
    "starter:clean": "turbo clean --filter=starter",
    "dnd:dev": "turbo dev --filter=dnd",
    "dnd:lint": "turbo lint --filter=dnd",
    "dnd:build": "turbo build --filter=dnd",
    "dnd:start": "turbo start --filter=dnd",
    "dnd:clean": "turbo clean --filter=dnd",
    "intl:dev": "turbo dev --filter=intl",
    "intl:lint": "turbo lint --filter=intl",
    "intl:build": "turbo build --filter=intl",
    "intl:start": "turbo start --filter=intl",
    "intl:clean": "turbo clean --filter=intl",
    "gen-icons": "turbo gen-icons --filter=core",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "9.23.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "2.4.4",
    "typescript-config": "workspace:*"
  },
  "packageManager": "pnpm@9.1.4",
  "pnpm": {
    "overrides": {
      "@babel/core@^7.0.0": "^7.29.13",
      "@babel/helpers@^7.0.0": "^7.29.14",
      "@babel/runtime@^7.0.0": "^7.29.14",
      "@humanfs/node@~0.16.0": "~0.16.8",
      "@turbo/workspaces@^2.0.0": "^2.11.12",
      "ajv@^6.0.0": "^6.15.0",
      "baseline-browser-mapping@^2.0.0": "^2.11.38",
      "basic-ftp@^5.0.0": "^5.3.1",
      "brace-expansion@^1.0.0": "^1.1.22",
      "brace-expansion@^2.0.0": "^2.1.8",
      "browserslist@^4.0.0": "^4.29.6",
      "diff@^4.0.0": "^4.0.4",
      "dompurify@^2.0.0": "^2.5.9",
      "dompurify@^3.0.0": "^3.4.18",
      "effect@^3.0.0": "^3.22.4",
      "engine.io@^6.0.0": "^6.6.11",
      "fast-uri@^3.0.0": "^3.1.9",
      "fflate@~0.8.0": "~0.8.3",
      "flatted@^3.0.0": "^3.4.4",
      "glob@^10.0.0": "^10.5.0",
      "glob@^11.0.0": "^11.1.0",
      "handlebars@^4.0.0": "^4.7.10",
      "js-cookie@^3.0.0": "^3.0.8",
      "js-yaml@^4.0.0": "^4.3.2",
      "lodash-es@^4.0.0": "^4.18.1",
      "lodash@^4.0.0": "^4.18.1",
      "minimatch@^10.0.0": "^10.2.6",
      "minimatch@^3.0.0": "^3.1.5",
      "minimatch@^9.0.0": "^9.0.9",
      "moment@^2.0.0": "^2.31.0",
      "nanoid@^3.0.0": "^3.3.20",
      "next-auth@^4.0.0": "^4.24.15",
      "next-intl@^4.0.0": "^4.15.1",
      "next@^15.0.0": "^15.5.29",
      "picomatch@^2.0.0": "^2.3.2",
      "picomatch@^4.0.0": "^4.0.7",
      "postcss-selector-parser@^6.0.0": "^6.1.6",
      "postcss@^8.0.0": "^8.5.33",
      "prismjs@^1.0.0": "^1.30.0",
      "serialize-javascript@^7.0.0": "^7.1.4",
      "socket.io-parser@^4.0.0": "^4.2.7",
      "source-map-js@^1.0.0": "^1.2.2",
      "turbo@^2.0.0": "^2.11.12",
      "ws@^8.0.0": "^8.23.0",
      "yaml@^1.0.0": "^1.10.3",
      "yaml@^2.0.0": "^2.9.1",
      "zod@^4.0.0": "^4.6.7"
    }
  }
}
